rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'admin';
    }

    // Public read-only for active menu items and system store status settings.
    // Writes require a verified admin (staff/{uid}.role == 'admin') - this
    // used to just check request.auth != null, which let any signed-in
    // customer edit the menu or site settings directly via the client SDK.
    match /menu/{item} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system/{setting} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profile documents: User can read/write their own document only
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Orders: Allow create and read for orders (User tracking and Kitchen Panel)
    match /orders/{orderId} {
      allow create, read, update: if true;
      allow delete: if request.auth != null;
    }

    // FCM Device Tokens
    match /deviceTokens/{token} {
      allow create, update: if true;
      allow read, delete: if request.auth != null;
    }

    // Support Chat Messages
    match /chats/{chat}/messages/{message} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // Wallet Transactions: Strict user ownership check
    match /walletTransactions/{transId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null;
    }

    // Kitchens ("hotels"): a hotel can only read/write its own record - its
    // Firebase Auth uid is minted (by api/hotel-auth.cjs) to equal its own
    // hotels/{hotelId} doc id, so request.auth.uid == hotelId identifies it.
    // Previously any signed-in user (any customer) could read or write any
    // hotel's record, including its password field.
    match /hotels/{hotelId} {
      allow read: if true;
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == hotelId);
    }

    // Delivery riders: a rider can only read/write their own document.
    // Previously any signed-in user could read or write any rider's record.
    match /riders/{riderId} {
      allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == riderId);
    }

    // Staff/admin role records: only admins manage these; a staff member can
    // read their own record to see their own role.
    match /staff/{staffId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == staffId);
      allow write: if isAdmin();
    }

    // Blacklisted deleted accounts lookup
    match /blacklistedDeletedAccounts/{accKey} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Catch-all default deny for all other unlisted collections
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
