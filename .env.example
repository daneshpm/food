# Firebase Client Config (Public Safe)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
VITE_FIREBASE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID

# Razorpay Config (Public Key exposed to client, Secret Key kept server-side)
VITE_RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET_SERVER_ONLY

# Telegram Integration (Server Side Only)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_IDS=YOUR_CHAT_ID_1,YOUR_CHAT_ID_2

# Admin Credentials & Security (Server Side Only)
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_AUTH_TOKEN=your_secure_jwt_token_secret

# Firebase Admin SDK (Server Side Only) - required for admin/hotel login to
# get a real Firebase Auth session (both in production and in `npm run dev`,
# via vite.config.ts's dev mock). Without this, admin/hotel login still
# succeeds against ADMIN_EMAIL/PASSWORD or a hotel's stored password, but
# has no real session, so Firestore-rule-gated data (hotels/riders/staff)
# stays inaccessible. Get this from Firebase Console -> Project Settings ->
# Service Accounts -> Generate new private key, then base64-encode the
# downloaded JSON file:
#   node -e "console.log(Buffer.from(require('fs').readFileSync('serviceAccountKey.json')).toString('base64'))"
FIREBASE_SERVICE_ACCOUNT=YOUR_BASE64_ENCODED_SERVICE_ACCOUNT_JSON
# Alternative to FIREBASE_SERVICE_ACCOUNT if you already have these split out:
# FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"